[Unit]
Description=Hiro A12 booth order sync API
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/hiro-a12-api
StateDirectory=hiro-a12-api
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=19130
Environment=ORDER_DATA_DIR=/var/lib/hiro-a12-api
Environment=ALLOWED_ORIGINS=https://qing.matto.top
EnvironmentFile=/etc/hiro-a12-api/admin.env
ExecStart=/usr/local/bin/node /opt/hiro-a12-api/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
